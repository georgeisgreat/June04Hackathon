<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agentic Workflows - Microsoft Azure Pitch Deck</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
            background: #f5f5f5;
            overflow: hidden;
        }

        .presentation-container {
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .slide {
            width: 100%;
            max-width: 1600px;
            aspect-ratio: 16 / 9;
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
            display: none;
            overflow: hidden;
        }

        .slide.active {
            display: flex;
        }

        /* SLIDE 1 STYLES */
        .slide-1 {
            flex-direction: column;
        }

        .slide-1-header {
            background: linear-gradient(135deg, #0078d4 0%, #107c10 100%);
            color: white;
            padding: 40px 60px;
            flex: 0 0 auto;
        }

        .slide-1-header h1 {
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .slide-1-header p {
            font-size: 24px;
            font-weight: 300;
            opacity: 0.95;
        }

        .slide-1-content {
            flex: 1;
            display: flex;
            overflow: hidden;
        }

        .slide-1-left {
            flex: 0 0 45%;
            padding: 40px;
            border-right: 1px solid #e0e0e0;
            overflow-y: auto;
        }

        .slide-1-right {
            flex: 0 0 55%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #f7f7f7 0%, #ffffff 100%);
            overflow-y: auto;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: #0078d4;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
            margin-top: 20px;
        }

        .section-title:first-child {
            margin-top: 0;
        }

        .slide-1-left .section-title {
            color: #107c10;
        }

        .problem-list, .solution-list {
            font-size: 14px;
            line-height: 1.8;
            color: #2d2d2d;
            margin-bottom: 20px;
        }

        .problem-list li, .solution-list li {
            margin-left: 20px;
            margin-bottom: 8px;
        }

        .comparison-item {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
            font-size: 14px;
            gap: 15px;
        }

        .comparison-left {
            font-weight: 600;
            color: #2d2d2d;
            min-width: 90px;
        }

        .comparison-arrow {
            color: #0078d4;
            font-weight: 700;
        }

        .comparison-right {
            background: #0078d4;
            color: white;
            padding: 6px 12px;
            border-radius: 4px;
            font-weight: 600;
        }

        .diagram-section {
            background: white;
            border-radius: 8px;
            padding: 24px;
            margin-top: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .diagram-title {
            font-size: 14px;
            font-weight: 700;
            color: #0078d4;
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .flow-diagram {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .flow-box {
            background: linear-gradient(135deg, #0078d4 0%, #1084d7 100%);
            color: white;
            padding: 12px 16px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            text-align: center;
            flex: 1;
            min-width: 80px;
        }

        .flow-arrow {
            color: #0078d4;
            font-size: 18px;
            font-weight: 700;
        }

        .key-message {
            background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
            border-left: 4px solid #0078d4;
            padding: 16px;
            border-radius: 4px;
            margin-top: 20px;
            font-size: 13px;
            line-height: 1.6;
            color: #1a1a1a;
            font-weight: 500;
        }

        .market-validation {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 20px;
        }

        .metric-card {
            background: white;
            border-radius: 8px;
            padding: 16px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .metric-number {
            font-size: 28px;
            font-weight: 700;
            color: #0078d4;
            margin-bottom: 4px;
        }

        .metric-label {
            font-size: 12px;
            color: #666;
            font-weight: 500;
        }

        /* SLIDE 2 STYLES */
        .slide-2 {
            flex-direction: column;
        }

        .slide-2-header {
            background: linear-gradient(135deg, #0078d4 0%, #107c10 100%);
            color: white;
            padding: 35px 60px;
            flex: 0 0 auto;
        }

        .slide-2-header h1 {
            font-size: 44px;
            font-weight: 700;
            margin-bottom: 6px;
            letter-spacing: -0.5px;
        }

        .slide-2-header p {
            font-size: 18px;
            font-weight: 300;
            opacity: 0.95;
        }

        .slide-2-content {
            flex: 1;
            display: flex;
            overflow: hidden;
        }

        .slide-2-left {
            flex: 0 0 50%;
            padding: 35px;
            border-right: 1px solid #e0e0e0;
            overflow-y: auto;
        }

        .slide-2-right {
            flex: 0 0 50%;
            padding: 35px;
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #f7f7f7 0%, #ffffff 100%);
            overflow-y: auto;
        }

        .architecture-box {
            background: white;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 16px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .architecture-header {
            font-size: 13px;
            font-weight: 700;
            color: #0078d4;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .architecture-items {
            font-size: 12px;
            line-height: 1.7;
            color: #2d2d2d;
        }

        .architecture-items strong {
            color: #0078d4;
        }

        .cost-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .cost-table tr {
            border-bottom: 1px solid #e0e0e0;
        }

        .cost-table tr:last-child {
            border-bottom: none;
        }

        .cost-table td {
            padding: 12px;
            font-size: 13px;
        }

        .cost-table td:first-child {
            font-weight: 600;
            color: #2d2d2d;
        }

        .cost-table td:last-child {
            text-align: right;
            font-weight: 600;
            color: #0078d4;
        }

        .cost-table tr.total-row {
            background: #f0f0f0;
            font-weight: 700;
            border-top: 2px solid #0078d4;
        }

        .assumptions-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }

        .assumption-item {
            background: white;
            border-radius: 6px;
            padding: 12px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
        }

        .assumption-label {
            font-size: 11px;
            color: #666;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .assumption-value {
            font-size: 20px;
            font-weight: 700;
            color: #0078d4;
        }

        .bottom-statement {
            background: linear-gradient(135deg, #0078d4 0%, #1084d7 100%);
            color: white;
            padding: 16px;
            border-radius: 6px;
            font-size: 12px;
            line-height: 1.6;
            margin-top: auto;
        }

        /* NAVIGATION */
        .nav-buttons {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 15px;
            z-index: 100;
        }

        .nav-btn {
            background: white;
            border: 2px solid #0078d4;
            color: #0078d4;
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
        }

        .nav-btn:hover {
            background: #0078d4;
            color: white;
            box-shadow: 0 4px 12px rgba(0, 120, 212, 0.3);
        }

        .nav-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .slide-counter {
            position: fixed;
            top: 20px;
            right: 30px;
            font-size: 14px;
            font-weight: 600;
            color: #0078d4;
            background: white;
            padding: 8px 16px;
            border-radius: 6px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        /* SCROLLBAR STYLING */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #0078d4;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #107c10;
        }
    </style>
</head>
<body>
    <div class="presentation-container">
        <!-- SLIDE 1 -->
        <div class="slide slide-1 active">
            <div class="slide-1-header">
                <h1>The GitHub for Agentic Workflows</h1>
                <p>Enabling teams to create, share, collaborate on, and execute AI workflows at scale</p>
            </div>
            
            <div class="slide-1-content">
                <div class="slide-1-left">
                    <div class="section-title">The Problem</div>
                    <p style="font-size: 14px; color: #2d2d2d; margin-bottom: 12px;">AI workflows are trapped inside individual chats, IDE sessions, and prompt libraries.</p>
                    <ul class="problem-list">
                        <li>Duplicate work across teams</li>
                        <li>Lost AI knowledge</li>
                        <li>No workflow version control</li>
                        <li>No collaborative development</li>
                        <li>No governance or discoverability</li>
                    </ul>

                    <div class="section-title">The Solution</div>
                    <ul class="solution-list">
                        <li>Create reusable agentic workflows</li>
                        <li>Share workflows across teams</li>
                        <li>Fork and customize workflows</li>
                        <li>Collaboratively improve workflows</li>
                        <li>Execute from GitHub Copilot</li>
                        <li>Build organizational AI knowledge</li>
                    </ul>
                </div>

                <div class="slide-1-right">
                    <div class="section-title">The Analogy</div>
                    <div class="comparison-item">
                        <span class="comparison-left">Code</span>
                        <span class="comparison-arrow">→</span>
                        <span class="comparison-right">GitHub</span>
                    </div>
                    <div class="comparison-item">
                        <span class="comparison-left">Documents</span>
                        <span class="comparison-arrow">→</span>
                        <span class="comparison-right">Notion</span>
                    </div>
                    <div class="comparison-item">
                        <span class="comparison-left">Design</span>
                        <span class="comparison-arrow">→</span>
                        <span class="comparison-right">Figma</span>
                    </div>
                    <div class="comparison-item">
                        <span class="comparison-left">AI Workflows</span>
                        <span class="comparison-arrow">→</span>
                        <span class="comparison-right">Our Platform</span>
                    </div>

                    <div class="diagram-section">
                        <div class="diagram-title">Platform Architecture</div>
                        <div class="flow-diagram">
                            <div class="flow-box">Developer</div>
                            <div class="flow-arrow">→</div>
                            <div class="flow-box">AI Workflow</div>
                        </div>
                        <div class="flow-diagram" style="margin-top: 12px;">
                            <div class="flow-arrow" style="flex: 0; text-align: center;">↓</div>
                        </div>
                        <div class="flow-diagram" style="margin-top: 12px;">
                            <div class="flow-box">Shared Repository</div>
                            <div class="flow-arrow">→</div>
                            <div class="flow-box">Collaboration</div>
                        </div>
                        <div class="flow-diagram" style="margin-top: 12px;">
                            <div class="flow-arrow" style="flex: 0; text-align: center;">↓</div>
                        </div>
                        <div class="flow-diagram" style="margin-top: 12px;">
                            <div class="flow-box" style="flex: 1;">Organizational Knowledge Graph</div>
                        </div>
                    </div>

                    <div class="market-validation">
                        <div class="metric-card">
                            <div class="metric-number">30M+</div>
                            <div class="metric-label">Software Developers</div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-number">20M+</div>
                            <div class="metric-label">GitHub Copilot Users</div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-number">50+</div>
                            <div class="metric-label">Target Teams Y1</div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-number">1K+</div>
                            <div class="metric-label">Projected Users</div>
                        </div>
                    </div>

                    <div class="key-message">
                        <strong>Key Insight:</strong> Just as GitHub transformed source code into a collaborative asset, we transform AI workflows into organizational knowledge that compounds over time.
                    </div>
                </div>
            </div>
        </div>

        <!-- SLIDE 2 -->
        <div class="slide slide-2">
            <div class="slide-2-header">
                <h1>Supporting 1,000 Users with Azure AI</h1>
                <p>Year-1 Infrastructure: $35K–50K | Azure Credit Request: $25K</p>
            </div>
            
            <div class="slide-2-content">
                <div class="slide-2-left">
                    <div class="section-title">Architecture Overview</div>
                    
                    <div class="architecture-box">
                        <div class="architecture-header">Azure OpenAI</div>
                        <div class="architecture-items">
                            Planner Agents • Coding Agents • Review Agents • Testing Agents • Documentation Agents
                        </div>
                    </div>

                    <div class="architecture-box">
                        <div class="architecture-header">Azure AI Search</div>
                        <div class="architecture-items">
                            Workflow Discovery • Semantic Search • RAG • Organizational Memory
                        </div>
                    </div>

                    <div class="architecture-box">
                        <div class="architecture-header">Azure Container Apps</div>
                        <div class="architecture-items">
                            Workflow Execution • Tool Invocation • Parallel Agent Runs
                        </div>
                    </div>

                    <div class="architecture-box">
                        <div class="architecture-header">Data & Collaboration</div>
                        <div class="architecture-items">
                            <strong>Cosmos DB + Blob Storage:</strong> Versions, History, Knowledge<br>
                            <strong>SignalR:</strong> Real-time Collaboration, Multi-user Editing
                        </div>
                    </div>

                    <div class="architecture-box">
                        <div class="architecture-header">Observability</div>
                        <div class="architecture-items">
                            Cost Analytics • Reliability • Evaluation Framework
                        </div>
                    </div>
                </div>

                <div class="slide-2-right">
                    <div class="section-title">Usage Assumptions (Year 1)</div>
                    <div class="assumptions-grid">
                        <div class="assumption-item">
                            <div class="assumption-label">Registered Users</div>
                            <div class="assumption-value">1,000</div>
                        </div>
                        <div class="assumption-item">
                            <div class="assumption-label">Weekly Active</div>
                            <div class="assumption-value">200</div>
                        </div>
                        <div class="assumption-item">
                            <div class="assumption-label">Workflow Executions</div>
                            <div class="assumption-value">25K</div>
                        </div>
                        <div class="assumption-item">
                            <div class="assumption-label">Agent Invocations</div>
                            <div class="assumption-value">1.25M</div>
                        </div>
                        <div class="assumption-item">
                            <div class="assumption-label">Stored Versions</div>
                            <div class="assumption-value">100K</div>
                        </div>
                        <div class="assumption-item">
                            <div class="assumption-label">Collaboration Events</div>
                            <div class="assumption-value">50K</div>
                        </div>
                    </div>

                    <div class="section-title" style="margin-top: 30px;">Cost Breakdown</div>
                    <table class="cost-table">
                        <tr>
                            <td>Azure OpenAI</td>
                            <td>$15K–25K</td>
                        </tr>
                        <tr>
                            <td>Workflow Compute</td>
                            <td>$5K–10K</td>
                        </tr>
                        <tr>
                            <td>AI Search & Retrieval</td>
                            <td>$3K–5K</td>
                        </tr>
                        <tr>
                            <td>Collaboration Infrastructure</td>
                            <td>$2K–4K</td>
                        </tr>
                        <tr>
                            <td>Storage & Monitoring</td>
                            <td>$3K–6K</td>
                        </tr>
                        <tr class="total-row">
                            <td>TOTAL ESTIMATED SPEND</td>
                            <td>$35K–50K</td>
                        </tr>
                    </table>

                    <div style="background: #107c10; color: white; padding: 12px; border-radius: 6px; font-size: 13px; font-weight: 700; text-align: center; margin-bottom: 20px;">
                        Requested Azure Credits: $25K
                    </div>

                    <div class="bottom-statement">
                        <strong>Impact:</strong> These Azure credits will fund AI inference, workflow orchestration, retrieval systems, real-time collaboration, and observability required to validate collaborative agent workflows with our first 1,000 users and establish the foundation for enterprise-scale adoption.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="slide-counter">
        <span id="current-slide">1</span> / 2
    </div>

    <div class="nav-buttons">
        <button class="nav-btn" id="prev-btn" onclick="previousSlide()">← Previous</button>
        <button class="nav-btn" id="next-btn" onclick="nextSlide()">Next →</button>
    </div>

    <script>
        let currentSlide = 1;

        function showSlide(n) {
            const slides = document.querySelectorAll('.slide');
            
            if (n > slides.length) currentSlide = slides.length;
            if (n < 1) currentSlide = 1;
            
            slides.forEach(slide => slide.classList.remove('active'));
            slides[currentSlide - 1].classList.add('active');
            
            document.getElementById('current-slide').textContent = currentSlide;
            document.getElementById('prev-btn').disabled = currentSlide === 1;
            document.getElementById('next-btn').disabled = currentSlide === slides.length;
        }

        function nextSlide() {
            currentSlide++;
            showSlide(currentSlide);
        }

        function previousSlide() {
            currentSlide--;
            showSlide(currentSlide);
        }

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') nextSlide();
            if (e.key === 'ArrowLeft') previousSlide();
        });

        // Initialize
        showSlide(currentSlide);
    </script>
</body>
</html>


